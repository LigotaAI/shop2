# ── Shopify App Credentials ────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=write_orders,read_orders,write_fulfillments,read_customers

# ── PostgreSQL (shared with FastAPI fraud engine) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fraudengine
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── FastAPI Fraud Engine ───────────────────────────────────────────────────────
FRAUD_API_BASE_URL=http://localhost:8000
FRAUD_API_KEY=your_internal_api_key

# ── App Runtime ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
